.DS_Store
Thumbs.db
*.pid
*.seed
*.pid.lock

# ─── Build output (relevant once you add a frontend) ─────────────────────────
dist/
build/
.vite/

# ─── Editor / IDE ─────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ─── Testing / Coverage ───────────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Uploaded files (if you store local uploads before pushing to S3/Cloudinary) ─
uploads/
tmp/

