# ─── Dependencies ─────────────────────────────────────────────────────────────
# node_modules is regenerated from package.json via "npm install" — never commit it.
# It can be hundreds of MB and is 100% reproducible by anyone who clones the repo.
node_modules/

# ─── Environment Variables ───────────────────────────────────────────────────
# .env contains real secrets: MongoDB URI, JWT secrets, Razorpay keys, SMTP
# credentials. NEVER commit this. .env.example (with placeholder values) is
# the only env file that SHOULD be committed — it documents what variables
# are needed without exposing real values.
.env
.env.local
.env.development
.env.production
.env.*.local

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

